<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="MeshEditor.UI.MultilineTextPromptDialog"
		Width="720"
		Height="520"
		MinWidth="520"
		MinHeight="320"
		WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*">
	<TextBlock x:Name="PromptTextBlock" TextWrapping="Wrap"/>
	<TextBlock x:Name="DescriptionTextBlock" Grid.Row="1" Margin="0,8,0,0" Opacity="0.85"/>
	<TextBox x:Name="InputTextBox"
			 Grid.Row="2"
			 Margin="0,8,0,0"
			 AcceptsReturn="True"
			 TextWrapping="Wrap"
			 ScrollViewer.VerticalScrollBarVisibility="Auto"
			 ScrollViewer.HorizontalScrollBarVisibility="Auto"
			 FontFamily="Consolas"/>
	<StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
	  <Button Content="Cancel" Click="Cancel_Click"/>
	  <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
	</StackPanel>
  </Grid>
</Window>
