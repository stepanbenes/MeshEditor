<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="MeshEditor.UI.ValuePromptDialog"
		Width="420"
		Height="220"
		MinWidth="360"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
	<TextBlock x:Name="PromptTextBlock" Grid.Row="0" TextWrapping="Wrap"/>
	<TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,10,0,0"/>
	<CheckBox x:Name="OptionCheckBox" Grid.Row="2" Margin="0,10,0,0" IsVisible="False"/>
	<TextBlock x:Name="ValidationTextBlock" Grid.Row="3" Margin="0,8,0,0" Foreground="IndianRed" IsVisible="False" TextWrapping="Wrap"/>
	<StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
	  <Button Content="Cancel" Click="Cancel_Click"/>
	  <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
	</StackPanel>
  </Grid>
</Window>
