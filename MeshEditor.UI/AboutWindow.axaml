<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="MeshEditor.UI.AboutWindow"
		Title="About MeshEditor"
		Width="520"
		Height="320"
		CanResize="False"
		WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
	<TextBlock x:Name="ProductNameText" FontSize="20" FontWeight="SemiBold" />
	<TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,8,0,0" />
	<TextBlock x:Name="DescriptionText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />
	<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
	  <Button Content="Close" Click="Close_Click" />
	</StackPanel>
  </Grid>
</Window>
