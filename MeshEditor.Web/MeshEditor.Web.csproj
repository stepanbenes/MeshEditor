<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- the background worker (its own .NET runtime with the layer code) is published into wwwroot/worker -->
    <WorkerProject>..\MeshEditor.Web.Worker\MeshEditor.Web.Worker.csproj</WorkerProject>
    <WorkerPublishDir>$(MSBuildProjectDirectory)\obj\worker-publish\$(Configuration)\</WorkerPublishDir>
    <WorkerOutputDir>$(MSBuildProjectDirectory)\wwwroot\worker\</WorkerOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- the worker is published by the target below, not referenced: it runs in its own runtime -->
    <Content Remove="wwwroot\worker\**" />
  </ItemGroup>

  <Target Name="PublishWorker" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- the file names carry hashes: stale ones would pile up -->
    <RemoveDir Directories="$(WorkerPublishDir)" />
    <!-- restored here, since nothing references it; the restore runs in its own evaluation -->
    <MSBuild Projects="$(WorkerProject)" Targets="Restore" Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(WorkerProject)" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(WorkerPublishDir)" />
    <ItemGroup>
      <_WorkerFile Include="$(WorkerPublishDir)wwwroot\**\*" Exclude="$(WorkerPublishDir)wwwroot\**\*.br;$(WorkerPublishDir)wwwroot\**\*.gz" />
    </ItemGroup>
    <RemoveDir Directories="$(WorkerOutputDir)" />
    <Copy SourceFiles="@(_WorkerFile)" DestinationFiles="@(_WorkerFile->'$(WorkerOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot\worker\**" />
    </ItemGroup>
  </Target>

  <!-- the worker is published as static web assets; its own dotnet.js must not be taken for the app's -->
  <Target Name="RemoveWorkerFromPublishList" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('wwwroot/worker/'))" />
    </ItemGroup>
  </Target>

</Project>
