<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>MeshEditor.AvaloniaUI.Tests</RootNamespace>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="Avalonia.Headless.NUnit" Version="12.1.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MeshEditor.Avalonia\MeshEditor.Avalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="TestData\sample.obj" CopyToOutputDirectory="PreserveNewest" />
		<None Update="TestData\props.msh" CopyToOutputDirectory="PreserveNewest" />
		<None Update="TestData\props.res" CopyToOutputDirectory="PreserveNewest" />
		<!-- JSON written and read by the previous Newtonsoft.Json implementation (JsonCompatibilityTests) -->
		<None Update="TestData\NewtonsoftJsonReference.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
