<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeshEditor.AvaloniaUI.Dialogs.ConfigurePropertyColorsDialog"
        Title="Configure property colors"
        Width="300" Height="420" MinWidth="282" MinHeight="169"
        CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="12" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto,Auto">
		<Border Grid.ColumnSpan="4" BorderBrush="#ABADB3" BorderThickness="1">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="contentPanel" Margin="0,2" />
			</ScrollViewer>
		</Border>
		<Button x:Name="buttonReset" Grid.Row="1" Grid.Column="0" Content="Reset to Defaults" MinWidth="105" Margin="0,6,0,0"
		        HorizontalContentAlignment="Center" Click="buttonReset_Click" />
		<Button x:Name="buttonOK" Grid.Row="1" Grid.Column="2" Content="OK" MinWidth="63" Margin="0,6,4,0"
		        HorizontalContentAlignment="Center" IsDefault="True" Click="buttonOK_Click" />
		<Button x:Name="buttonCancel" Grid.Row="1" Grid.Column="3" Content="Cancel" MinWidth="63" Margin="0,6,0,0"
		        HorizontalContentAlignment="Center" IsCancel="True" Click="buttonCancel_Click" />
	</Grid>
</Window>
