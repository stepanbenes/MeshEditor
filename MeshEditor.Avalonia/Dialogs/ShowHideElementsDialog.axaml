<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeshEditor.AvaloniaUI.Dialogs.ShowHideElementsDialog"
        Title="Show / Hide elements"
        Width="440" Height="520" MinWidth="350" MinHeight="249"
        CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="9,10,9,9" RowDefinitions="*,Auto">
		<TabControl x:Name="tabControl" Padding="0,6,0,0">
			<TabItem x:Name="tabPagePropertyNumbers" Header="Property numbers" />
			<TabItem x:Name="tabPageElementTypes" Header="Element types" />
			<TabItem x:Name="tabPageValueLimit" Header="Value limit">
				<StackPanel Spacing="4" Margin="2,4">
					<TextBlock x:Name="label3" Text="Show elements with nodes in data value range" Margin="0,0,0,6" />
					<StackPanel Orientation="Horizontal" Spacing="6">
						<CheckBox x:Name="checkBoxMaximum" Content="Maximum" MinWidth="90" IsCheckedChanged="checkBoxMaximum_CheckedChanged" />
						<TextBox x:Name="textBoxMaximum" Text="0" Width="120" IsEnabled="False" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="6">
						<CheckBox x:Name="checkBoxMinimum" Content="Minimum" MinWidth="90" IsCheckedChanged="checkBoxMinimum_CheckedChanged" />
						<TextBox x:Name="textBoxMinimum" Text="0" Width="120" IsEnabled="False" />
					</StackPanel>
					<CheckBox x:Name="checkBoxInverse" Content="Inverse" IsEnabled="False" Margin="0,8,0,0" />
					<CheckBox x:Name="checkBoxAllNodesInRange" Content="All nodes of element in range" IsEnabled="False" />
				</StackPanel>
			</TabItem>
		</TabControl>
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,6,0,0">
			<Button x:Name="buttonApply" Content="Apply" MinWidth="68" HorizontalContentAlignment="Center" Click="buttonApply_Click" />
			<Button x:Name="buttonClose" Content="Close" MinWidth="68" HorizontalContentAlignment="Center" IsCancel="True" Click="buttonClose_Click" />
		</StackPanel>
	</Grid>
</Window>
