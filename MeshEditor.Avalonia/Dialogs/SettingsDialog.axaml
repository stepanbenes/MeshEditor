<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MeshEditor.AvaloniaUI.Controls"
        x:Class="MeshEditor.AvaloniaUI.Dialogs.SettingsDialog"
        Title="Settings"
        Width="420" Height="560" MinWidth="286" MinHeight="284"
        CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
	<Grid Margin="9,10,9,9" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*,Auto,Auto">
		<controls:PropertyGrid x:Name="propertyGrid" Grid.ColumnSpan="4" />
		<Button x:Name="buttonReset" Grid.Row="1" Grid.Column="0" Content="Reset to Defaults" MinWidth="119" Margin="0,6,0,0"
		        HorizontalContentAlignment="Center" Click="buttonReset_Click" />
		<Button x:Name="buttonOK" Grid.Row="1" Grid.Column="2" Content="OK" MinWidth="63" Margin="0,6,4,0"
		        HorizontalContentAlignment="Center" IsDefault="True" Click="buttonOK_Click" />
		<Button x:Name="buttonCancel" Grid.Row="1" Grid.Column="3" Content="Cancel" MinWidth="63" Margin="0,6,0,0"
		        HorizontalContentAlignment="Center" IsCancel="True" Click="buttonCancel_Click" />
	</Grid>
</Window>
