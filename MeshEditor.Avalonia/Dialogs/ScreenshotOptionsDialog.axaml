<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeshEditor.AvaloniaUI.Dialogs.ScreenshotOptionsDialog"
        Title="Screenshot options"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
	<StackPanel Margin="12,10,12,12" MinWidth="221" Spacing="4">
		<TextBlock x:Name="label1" Text="Take a screenshot of..." Margin="0,0,0,6" />
		<RadioButton x:Name="radioButtonWholeScene" GroupName="screenshotArea" Content="Whole scene" IsCheckedChanged="radioButtonWholeScene_CheckedChanged" />
		<RadioButton x:Name="radioButtonSelectionArea" GroupName="screenshotArea" Content="Selection area" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,8,0,0">
			<Button x:Name="buttonOK" Content="OK" MinWidth="63" HorizontalContentAlignment="Center" IsDefault="True" Click="buttonOK_Click" />
			<Button x:Name="buttonCancel" Content="Cancel" MinWidth="63" HorizontalContentAlignment="Center" IsCancel="True" Click="buttonCancel_Click" />
		</StackPanel>
	</StackPanel>
</Window>
